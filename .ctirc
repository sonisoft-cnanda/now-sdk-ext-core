{
  "spinnerStream": "stdout",
  "progressStream": "stdout",
  "reasonerStream": "stderr",
  "options": [
    {
      "mode": "bundle",
      "project": "./tsconfig.json",
      "exclude": [
        "assets",
        "cli",
        "types",
        "sn/amb",
        "comm/http/SessionManager"
      ],
      "exportFilename": "index.ts",
      "useSemicolon": true,
      "fileExt": "to-js",
      "overwrite": true,
      "output": "./src"
    }
  ]
}
