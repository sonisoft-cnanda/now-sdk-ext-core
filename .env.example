# ServiceNow instance alias used by the integration tests.
#
# Any alias from `nex auth list` works — the tests never hardcode one, so pointing them
# at a different instance is a one-variable change:
#
#   SN_INSTANCE_ALIAS=dev206299 npm run test:integration
#   SN_INSTANCE_ALIAS=strongtiedev npm run test:integration
#
# Integration tests do NOT run in CI. `npm run test:unit` — what CI runs — excludes
# /integration/, and these need credentials CI does not have.
#
# Current PDI:
SN_INSTANCE_ALIAS=dev206299

# Set when the OS keyring cannot be unlocked (SSH, systemd, CI, agent sessions).
# Without it getCredentials reports "no credentials" indistinguishably from having none.
SN_CRED_STORE_ENABLE=1
